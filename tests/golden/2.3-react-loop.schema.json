{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["chapter", "question", "max_steps", "status", "stop_reason", "answer", "trace"],
  "properties": {
    "chapter": { "const": "2.3-react-loop" },
    "question": { "type": "string" },
    "max_steps": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["answered", "stopped"] },
    "stop_reason": { "type": "string" },
    "answer": { "type": ["string", "null"] },
    "trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "thought", "action", "observation"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "thought": { "type": "string" },
          "action": {
            "type": "object",
            "required": ["tool", "input"],
            "properties": {
              "tool": { "type": "string" },
              "input": { "type": "object" }
            }
          },
          "observation": { "type": ["object", "null"] }
        }
      }
    }
  }
}
