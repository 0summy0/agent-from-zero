{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "chapter",
    "project",
    "question",
    "answer",
    "status",
    "stop_reason",
    "evidence",
    "trace",
    "trace_file",
    "usage",
    "memory",
    "plan_validation",
    "security",
    "evaluation",
    "max_steps",
    "teaching_scope"
  ],
  "properties": {
    "chapter": { "const": "4.4-capstone" },
    "project": { "const": "Local Research Desk" },
    "question": { "type": "string" },
    "answer": { "type": "string" },
    "status": { "enum": ["grounded", "abstain", "rejected"] },
    "stop_reason": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "text", "source"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "text": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    },
    "trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "thought", "action", "observation"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "thought": { "type": "string" },
          "action": { "type": "object" },
          "observation": { "type": ["object", "null"] }
        }
      }
    },
    "trace_file": {
      "type": "object",
      "required": ["name", "directory", "temporary", "event_count"],
      "properties": {
        "name": { "type": "string" },
        "directory": { "type": ["string", "null"] },
        "temporary": { "type": "boolean" },
        "event_count": { "type": "integer", "minimum": 1 }
      }
    },
    "usage": {
      "type": "object",
      "required": ["total_tokens", "tool_calls", "network_calls", "cost_usd"],
      "properties": {
        "total_tokens": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "network_calls": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "memory": { "type": "object" },
    "plan_validation": { "type": "object" },
    "security": { "type": "object" },
    "evaluation": { "type": "object" },
    "max_steps": { "type": "integer", "minimum": 1 },
    "teaching_scope": { "type": "string" }
  }
}
